<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.taller_git_gp1.controller.UsuarioController"
            prefHeight="400.0" prefWidth="600.0" stylesheets="@style.css">
    <children>
        <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <VBox prefWidth="250.0" styleClass="left-pane" HBox.hgrow="ALWAYS">
                    <children>
                        <ImageView fx:id="imgUnion" fitHeight="150.0" fitWidth="150.0"
                                   pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../img/blanco.png"/>
                            </image>
                        </ImageView>
                        <Label text="SISTEMA DE VENTAS"  textFill="WHITE">
                            <Font name="Arial Black" size="20.0"/>
                        </Label>
                    </children>
                </VBox>

                <VBox prefWidth="350.0" spacing="20.0" styleClass="right-pane" HBox.hgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
                    </padding>
                    <children>
                        <Label text="Iniciar Sesion" textFill="#000000">
                            <font> <Font name="System Bold" size="24.0"/></font>
                        </Label>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Usuario" textFill="#666666"/>
                                <TextField fx:id="txtUser" promptText="Ingrese usuario"/>
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label text="Password" textFill="#666666"/>
                                <PasswordField fx:id="txtPassword" promptText="*************"/>
                                <Button maxWidth="-Infinity" mnemonicParsing="false"
                                        styleClass="button-login" text="INGRESAR" onAction="#handleLogin">
                                    <VBox.margin>
                                        <Insets top="10.0"/>
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>