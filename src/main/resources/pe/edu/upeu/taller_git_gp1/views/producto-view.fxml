<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20.0"
      style="-fx-background-color: #F7F7F7; -fx-padding: 20;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_git_gp1.controller.ProductoController">
    <!-- encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Gestion de Productos" styleClass="lbl-titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ NUEVO PRODUCTO" onAction="#handleNew" styleClass="button-login"/>
    </HBox>
    <!-- buscador -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="txtBuscar"
                   promptText="Buscar producto por nombre..."
                   prefWidth="800.0"
                   onAction="#buscarProducto"/>
        <Button text="BUSCAR"
                onAction="#buscarProducto"
                styleClass="button-login"/>
    </HBox>
    <!-- tabla -->
    <TableView fx:id="tableProducto" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="ColNumber" text="N°" prefWidth="55.0"/>
            <TableColumn fx:id="ColID" text="ID" prefWidth="60.0" visible="false"/>
            <TableColumn fx:id="ColNombre" text="Nombre" prefWidth="190.0"/>
            <TableColumn fx:id="ColTipo" text="Tipo" prefWidth="150.0"/>
            <TableColumn fx:id="ColPrecio" text="Precio" prefWidth="100.0"/>
            <TableColumn fx:id="ColStock" text="Stock" prefWidth="90.0"/>
            <TableColumn fx:id="ColEstado" text="Estado" prefWidth="100.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <!-- botones -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="EDITAR" onAction="#handleEdit" styleClass="button-action-edit"/>
        <Button text="ELIMINAR" onAction="#handleDelete" styleClass="button-action-delete"/>
    </HBox>
</VBox>
