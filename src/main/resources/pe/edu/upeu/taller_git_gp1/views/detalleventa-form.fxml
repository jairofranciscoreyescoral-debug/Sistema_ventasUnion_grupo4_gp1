<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="15.0" prefWidth="1100.0" prefHeight="700.0"
      style="-fx-background-color: white;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_git_gp1.controller.DetalleVentaFormController">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>
    <Label text="AGREGAR PRODUCTOS A LA VENTA" styleClass="lbl-titulo"/>

    <Separator/>

    <HBox spacing="20.0" VBox.vgrow="ALWAYS">

        <!-- parte izquierda -->
        <VBox spacing="12.0" prefWidth="510.0" HBox.hgrow="ALWAYS">
            <Label text="AGREGAR PRODUCTO"
                   style="-fx-font-weight: bold; -fx-font-size: 15px;"/>

            <HBox spacing="8.0">
                <TextField fx:id="txtBuscar"
                           promptText="Buscar producto por nombre..."
                           HBox.hgrow="ALWAYS"/>
                <Button text="Buscar" onAction="#buscarProducto"
                        styleClass="button-save"/>
            </HBox>

            <Label text="LISTA DE PRODUCTOS"
                   style="-fx-font-weight: bold;"/>

            <TableView fx:id="tableProducto" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="ColNumero" text="N°" prefWidth="40.0"/>
                    <TableColumn fx:id="ColId" text="ID" prefWidth="45.0"/>
                    <TableColumn fx:id="ColNombre" text="Producto" prefWidth="180.0"/>
                    <TableColumn fx:id="ColPrecio" text="Precio" prefWidth="75.0"/>
                    <TableColumn fx:id="ColStock" text="Stock" prefWidth="65.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Separator/>

            <Label text="DATOS DEL PRODUCTO"
                   style="-fx-font-weight: bold;"/>

            <GridPane hgap="10.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="85.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Cantidad:"/>
                <TextField fx:id="txtCantidad"
                           promptText="Ingrese cantidad"
                           GridPane.columnIndex="1"/>
            </GridPane>

            <Button text="AGREGAR PRODUCTO"
                    onAction="#handleAgregar"
                    styleClass="button-action-edit"
                    maxWidth="Infinity"/>
        </VBox>

        <Separator orientation="VERTICAL"/>

        <!-- parte derecha -->
        <VBox spacing="12.0" prefWidth="510.0" HBox.hgrow="ALWAYS">
            <Label text="PRODUCTOS AGREGADOS"
                   style="-fx-font-weight: bold; -fx-font-size: 15px;"/>

            <TableView fx:id="tableDetalle" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="ColDetalleProducto" text="Producto" prefWidth="170.0"/>
                    <TableColumn fx:id="ColDetalleCantidad" text="Cantidad" prefWidth="75.0"/>
                    <TableColumn fx:id="ColDetallePrecio" text="Precio" prefWidth="85.0"/>
                    <TableColumn fx:id="ColDetalleSubtotal" text="Subtotal" prefWidth="90.0"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Separator/>

            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button text="Cancelar"
                        onAction="#handleCancelar"
                        styleClass="button-cancel"/>
                <Button text="Guardar detalles"
                        onAction="#handleGuardar"
                        styleClass="button-save"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>