<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="20.0"
      style="-fx-background-color: #F7F7F7; -fx-padding: 20;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_git_gp1.controller.ClienteController">

    <!-- encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="Gestion de Clientes" styleClass="lbl-titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ NUEVO CLIENTE"
                onAction="#handleNew"
                styleClass="button-login"/>
    </HBox>

    <!-- buscador -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <TextField fx:id="txtBuscar"
                   promptText="Buscar cliente por DNI"
                   prefWidth="800.0"
                   onAction="#buscarCliente"/>
        <Button text="BUSCAR"
                onAction="#buscarCliente"
                styleClass="button-login"/>
    </HBox>
    <!-- tabla -->
    <TableView fx:id="tableCliente" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="ColNumero" text="N°" prefWidth="55.0"/>
            <TableColumn fx:id="ColID" text="ID" prefWidth="60.0" visible="false"/>
            <TableColumn fx:id="ColNombres" text="Nombres" prefWidth="150.0"/>
            <TableColumn fx:id="ColApellidos" text="Apellidos" prefWidth="150.0"/>
            <TableColumn fx:id="ColDni" text="DNI" prefWidth="90.0"/>
            <TableColumn fx:id="ColEmail" text="Email" prefWidth="180.0"/>
            <TableColumn fx:id="ColGenero" text="Género" prefWidth="70.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <!-- botones -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="EDITAR"
                onAction="#handleEdit"
                styleClass="button-action-edit"/>
        <Button text="ELIMINAR"
                onAction="#handleDelete"
                styleClass="button-action-delete"/>
    </HBox>
</VBox>
