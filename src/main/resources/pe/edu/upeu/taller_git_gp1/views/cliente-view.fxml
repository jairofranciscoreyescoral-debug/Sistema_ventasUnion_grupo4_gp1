<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="15.0"
      style="-fx-background-color: #F4F6F9;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_git_gp1.controller.ClienteController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="25.0"/>
    </padding>

    <children>

        <Label text="GESTION DE CLIENTES"
               textFill="#263746"
               styleClass="lbl-titulo">
            <font>
                <Font name="System Bold" size="20.0"/>
            </font>
        </Label>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false"
                        onAction="#handleNew"
                        styleClass="button-save"
                        text="+ NUEVO CLIENTE"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button mnemonicParsing="false"
                        onAction="#handleEdit"
                        styleClass="button-action-edit"
                        text="EDITAR"/>

                <Button mnemonicParsing="false"
                        onAction="#handleDelete"
                        styleClass="button-action-delete"
                        text="ELIMINAR"/>
            </children>
        </HBox>

        <TableView fx:id="tableCliente"
                   prefWidth="692.0"
                   VBox.vgrow="ALWAYS">

            <columns>
                <TableColumn fx:id="ColNumero" prefWidth="50.0" text="N°"/>
                <TableColumn fx:id="ColID" prefWidth="50.0" text="ID" visible="false"/>
                <TableColumn fx:id="ColNombres" prefWidth="150.0" text="Nombres"/>
                <TableColumn fx:id="ColApellidos" prefWidth="150.0" text="Apellidos"/>
                <TableColumn fx:id="ColDni" prefWidth="90.0" text="DNI"/>
                <TableColumn fx:id="ColEmail" prefWidth="180.0" text="Email"/>
                <TableColumn fx:id="ColGenero" prefWidth="70.0" text="Género"/>
            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

    </children>
</VBox>
