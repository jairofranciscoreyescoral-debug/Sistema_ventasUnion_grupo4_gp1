<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="18.0" prefWidth="750.0" prefHeight="620.0"
      style="-fx-background-color: white;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_git_gp1.controller.VentaFormController">
    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>
    <Label fx:id="lblTitulo" text="REGISTRAR NUEVA VENTA" styleClass="lbl-titulo"/>
    <Separator/>
    <!-- Datos de venta -->
    <GridPane hgap="15.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Cliente:"/>
        <VBox spacing="5.0" GridPane.columnIndex="1">
            <HBox spacing="5.0">
                <TextField fx:id="txtBuscarDni" promptText="Ingrese DNI"
                           prefHeight="40.0" HBox.hgrow="ALWAYS"/>
                <Button text="BUSCAR" onAction="#handleBuscarCliente"
                        styleClass="button-save"/>
            </HBox>
            <ComboBox fx:id="cbCliente" maxWidth="Infinity" prefHeight="40.0"/>
        </VBox>
        <Label text="Fecha:" GridPane.columnIndex="2"/>
        <DatePicker fx:id="dpFecha" maxWidth="Infinity"
                    prefHeight="40.0" GridPane.columnIndex="3"/>

        <Label text="Vendedor:" GridPane.rowIndex="1"/>
        <Label fx:id="lblUsuario" text="Usuario"
               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>
    <Separator/>
    <!-- Detalle de productos -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Label text="PRODUCTOS DE LA VENTA"
               style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ AGREGAR PRODUCTOS" onAction="#handleAddDetalle"
                styleClass="button-save"/>
    </HBox>
    <TableView fx:id="tableDetalle" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="ColProducto" text="Producto" prefWidth="280.0"/>
            <TableColumn fx:id="ColCantidad" text="Cantidad" prefWidth="100.0"/>
            <TableColumn fx:id="ColPrecio" text="Precio" prefWidth="120.0"/>
            <TableColumn fx:id="ColSubtotal" text="Subtotal" prefWidth="120.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <!-- Total -->
    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Label text="TOTAL:" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label fx:id="lblTotal" text="0.00"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    </HBox>
    <Separator/>
    <!-- Botones -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button text="Cancelar" onAction="#handleCancel" styleClass="button-cancel"/>
        <Button text="Imprimir boleta" onAction="#handleImprimir" styleClass="button-action-edit"/>
        <Button text="Guardar venta" onAction="#handleSave" styleClass="button-save"/>
    </HBox>
</VBox>
