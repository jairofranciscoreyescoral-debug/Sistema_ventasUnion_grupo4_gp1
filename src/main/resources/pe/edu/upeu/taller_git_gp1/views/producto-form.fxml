<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="18.0" prefWidth="450.0"
      style="-fx-background-color: #F7F7F7;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_git_gp1.controller.ProductoFormController">
    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>
    <Label fx:id="lblTitulo" text="Datos del Producto"
           styleClass="lbl-titulo"/>
    <Separator/>

    <GridPane hgap="12.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints minWidth="100.0"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="Nombre:"/>
        <TextField fx:id="txtNombre" promptText="Ingrese nombre"
                   GridPane.columnIndex="1"/>
        <Label text="Tipo:" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cbTipo" maxWidth="Infinity"
                  promptText="Seleccione tipo"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="Precio:" GridPane.rowIndex="2"/>
        <TextField fx:id="txtPrecio" promptText="Ingrese precio"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="Stock:" GridPane.rowIndex="3"/>
        <TextField fx:id="txtStock" promptText="Ingrese stock"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="Estado:" GridPane.rowIndex="4"/>
        <ComboBox fx:id="cbEstado" maxWidth="Infinity"
                  promptText="Seleccione estado"
                  GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <Separator/>

    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Cancelar" onAction="#handleCancel"
                styleClass="button-cancel"/>
        <Button text="Guardar" onAction="#handleSave"
                styleClass="button-save"/>
    </HBox>
</VBox>
