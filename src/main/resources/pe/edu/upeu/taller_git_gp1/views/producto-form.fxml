<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F7F7F7"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.taller_git_gp1.controller.ProductoController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestion de Productos" textFill="#014074">
                    <font>
                        <Font name="System Bold" size="20.0"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false"
                        onAction="#handleNew"
                        styleClass="button-login"
                        text="+ NUEVO"/>
            </children>
        </HBox>
        <TableView fx:id="tableProducto" prefWidth="692.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNumber" prefWidth="50.0" text="N°"/>
                <TableColumn fx:id="ColID" prefWidth="50.0"
                             text="ID" visible="false"/>
                <TableColumn fx:id="ColNombre" prefWidth="150.0"
                             text="Nombre"/>
                <TableColumn fx:id="ColTipo" prefWidth="120.0"
                             text="Tipo"/>
                <TableColumn fx:id="ColPrecio" prefWidth="90.0"
                             text="Precio"/>
                <TableColumn fx:id="ColStock" prefWidth="90.0"
                             text="Stock"/>
                <TableColumn fx:id="ColEstado" prefWidth="90.0"
                             text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false"
                        onAction="#handleEdit"
                        styleClass="button-action-edit"
                        text="EDITAR"/>
                <Button mnemonicParsing="false"
                        onAction="#handleDelete"
                        styleClass="button-action-delete"
                        text="ELIMINAR"/>
            </children>
        </HBox>
    </children>
</VBox>
